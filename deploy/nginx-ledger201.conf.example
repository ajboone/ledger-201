# Replace server_name before configuring DNS/TLS. HTTP bootstrap only.
server {
    listen 80;
    server_name ledger.example.com;
    root /var/www/ledger201;
    index index.html;
    client_max_body_size 2m;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Analyst calls can involve several provider rounds.
    proxy_read_timeout 300s;

    # No URI suffix: preserve /api exactly as FastAPI routers expect.
    location = /api {
        proxy_pass http://127.0.0.1:8000;
    }
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8000;
    }
    location = /health {
        proxy_pass http://127.0.0.1:8000;
    }
    location ^~ /health/ {
        return 404;
    }
    location ^~ /assets/ {
        try_files $uri =404;
    }
    # Missing static files must not receive the SPA HTML.
    location ~* \.(?:js|mjs|css|map|json|ico|png|jpe?g|gif|svg|webp|avif|woff2?|ttf|otf|lottie|txt|xml|webmanifest)$ {
        try_files $uri =404;
    }
    location ~ /\. {
        deny all;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
